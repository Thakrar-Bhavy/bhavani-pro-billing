   if(i===matches.length-1&&!prefixHasItem&&i>0)desc=chunk.slice(matches[i-1].index+matches[i-1][0].length,m.index);
   const amount=Number((m[1]||m[2]).replace(/,/g,''));
   desc=cleanDescription(desc);
