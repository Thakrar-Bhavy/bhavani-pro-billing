  .filter(Boolean).sort((a,b)=>b.length-a.length);
 const hits=[];
 aliases.forEach(alias=>{
  const re=new RegExp('(^|\\s)('+alias.replace(/[.*+?^${}()|[\\]\\]/g,'\\$&')+')(?=\\s|$)','ig');
  let m; while((m=re.exec(chunk))!==null){
   const start=m.index+m[1].length;
   if(!hits.some(h=>Math.abs(h.start-start)<2))hits.push({start,end:start+m[2].length,alias});
  }
 });
 hits.sort((a,b)=>a.start-b.start);
 const unique=[];
 hits.forEach(h=>{if(!unique.length||h.start>=unique[unique.length-1].end)unique.push(h)});
 if(unique.length<2)return [chunk];
 const cuts=unique.slice(1).map(h=>h.start),out=[];let last=0;
 cuts.forEach(c=>{const part=chunk.slice(last,c).trim();if(part)out.push(part);last=c});
 const tail=chunk.slice(last).trim();if(tail)out.push(tail);
 return out.length>1?out:[chunk];
}
function canonicalProductName(description){
 const found=findCatalogProduct(description);if(found)return found.name;
 let text=String(description||'').trim().replace(/^\\s*\\d+(?:\\.\\d+)?\\s*(?:kg|કિલો|કિગ્રા|gm|g|ગ્રામ|ltr|litre|liter|ml|pc|pcs|પીસ)?\\s*/i,'');
 const low=text.toLowerCase();
 const alias=Object.keys(PRODUCT_ALIASES).sort((a,b)=>b.length-a.length).find(k=>new RegExp('(^|\\s)'+k.replace(/[.*+?^${}()|[\\]\\]/g,'\\\\$&')+'($|\\s)','i').test(low));
 return alias?PRODUCT_ALIASES[alias]:text;
}
function learnProductsFromBill(lines){
 let changed=false;
 (lines||[]).forEach(line=>{
  const name=canonicalProductName(line.description);if(!name)return;
  const qty=Number(line.quantity||extractQuantity(line.description).qty||1);
  const total=Number(line.amount||0);if(!(total>0)||!(qty>0))return;
  const unitPrice=Math.round((total/qty)*100)/100;
  let product=(db.products||[]).find(p=>p.id===line.productId)||findCatalogProduct(name);
  if(!product){
   product={id:id(),name,category:'Other',salePrice:unitPrice,updatedAt:Date.now()};
   db.products.push(product);line.productId=product.id;changed=true;
  }else{
   line.productId=product.id;
   if(Number(product.salePrice)!==unitPrice){product.salePrice=unitPrice;product.updatedAt=Date.now();changed=true;}
  }
 });
 if(changed)saveDB();
}

function parse(raw){
 let t=normalizeDigits(raw).trim();if(!t)return null;
 const low=t.toLowerCase();
 const paymentWords=/(?:paid|payment|jama|જમા|આપ્યા|ભર્યા|ચૂકવ્યા|ચૂકવણી|પૈસા આપ્યા|રકમ મળી|received)/i;
 const type=paymentWords.test(low)?'payment':'credit';
 let customer=[...db.customers].sort((a,b)=>b.name.length-a.name.length).find(c=>low.includes(c.name.toLowerCase()))||null;
 let work=t;
 if(customer)work=work.replace(new RegExp(customer.name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'ig'),' ');
 work=work.replace(/(?:ખાતામાં લખો|ખાતામા લખો|ખાતામાં નાખો|ખાતે લખો|ખાતામાં|ખાતામા|ખાતું|ખાતા|ખાતો|ખતામાં|ઉધાર|જમા કરો|પેમેન્ટ|કેશ બિલ|cash bill|bill|khatama lakho|khata ma lakho|udhar|khata|credit|payment|paid|jama|received|ને|ના ખાતામાં|ના ખતામાં)/ig,' ');
 // Split only at strong item separators, not ordinary spaces inside product names.
 const rawChunks=work.split(/[,;\n]+|\s+(?:and|અને|પછી)\s+/i).map(x=>x.trim()).filter(Boolean);
 const chunks=rawChunks.flatMap(splitChunkByKnownProducts);
 let lines=chunks.flatMap(parseCatalogChunk);
 if(type==='payment'){
  const pm=t.match(/(?:₹|rs\.?|rupees?|inr|રૂપિયા|રૂપીયા)?\s*([\d,]+(?:\.\d+)?)/i);
  if(pm){const amount=Number(pm[1].replace(/,/g,''));if(amount>0)lines=[{description:'Payment received',amount,productId:'',quantity:1,unit:'',rate:amount,priceSource:'spoken'}]}
 }
 let detectedCustomer=customer;
 if(!detectedCustomer){
  const first=t.match(/^\s*([\p{L}][\p{L}\s]{1,30}?)\s+(?=\d|(?:2|3|4|5)\s*(?:kg|કિલો))/iu);
  if(first){let candidate=first[1].replace(/(?:ભાઈ|ભાઇ|બેન|બહેન)$/,'').trim();if(candidate&&!/^(2|3|4|5)$/.test(candidate))detectedCustomer={id:null,name:candidate,phone:''}}
 }
 return {type,customer:detectedCustomer,lines,raw:t,needsPrice:lines.some(l=>!(Number(l.amount)>0))};
}
