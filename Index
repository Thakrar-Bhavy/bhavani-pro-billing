 let m=text.match(new RegExp('^\\s*(\\d+(?:\\.\\d+)?)\\s*('+unitPattern+')?\\s*','i'));
 if(!m)m=text.match(new RegExp('(\\d+(?:\\.\\d+)?)\\s*('+unitPattern+')','i'));
 if(!m)return {qty:1,unit:''};
 let q=Number(m[1]),u=(m[2]||'').toLowerCase();
 if(['gm','g','ગ્રામ','ગ્રા'].includes(u)){q/=1000;u='kg'}
 if(['ml'].includes(u)){q/=1000;u='ltr'}
 if(['કિલો','કિગ્રા','કિ.ગ્રા','કિલોગ્રામ'].includes(u))u='kg';
 if(['liter','litre'].includes(u))u='ltr';
