 try{
  while(pendingOps.length&&navigator.onLine){
   const batch=pendingOps.slice(0,10);
   const res=await jsonp({action:'batch',ops:JSON.stringify(batch)});
   if(!res||res.ok!==true)throw new Error(res?.error||'Save was not confirmed');
   pendingOps.splice(0,batch.length);storePending();setSyncStatus();
