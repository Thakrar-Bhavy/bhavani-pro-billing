function findCatalogProduct(description){
 const raw=String(description||'').trim();
 const stripped=raw.replace(/^\s*\d+(?:\.\d+)?\s*(?:kg|કિલો|કિગ્રા|કિ\.ગ્રા|gm|g|ગ્રામ|લિટર|ltr|litre|ml|packet|પેકેટ|પીસ|pcs)?\s*/i,'');
 const clean=normalizeProductText(stripped);
 const products=db.products||[];
 let found=products.find(p=>normalizeProductText(p.name)===clean);
 if(found)return found;
 const lower=raw.toLowerCase();
 const alias=Object.keys(PRODUCT_ALIASES).sort((x,y)=>y.length-x.length).find(k=>lower.includes(k));
 if(alias){
  const target=normalizeProductText(PRODUCT_ALIASES[alias]);
  found=products.find(p=>normalizeProductText(p.name)===target);
  if(found)return found;
 }
 found=products.find(p=>{const n=normalizeProductText(p.name);return n.length>2&&(clean.includes(n)||n.includes(clean)&&clean.length>=4)});
 if(found)return found;
 // Conservative token overlap fallback; require a strong match to avoid wrong products.
 const tokens=clean.match(/[a-z0-9]+|[\u0A80-\u0AFF]+/gu)||[];
 let best=null,bestScore=0;
 products.forEach(p=>{
  const pn=normalizeProductText(p.name),pt=pn.match(/[a-z0-9]+|[\u0A80-\u0AFF]+/gu)||[];
  const common=tokens.filter(t=>pt.some(x=>x===t||x.includes(t)&&t.length>2)).length;
  const score=common/Math.max(tokens.length,pt.length,1);
  if(score>bestScore){bestScore=score;best=p}
 });
