document.getElementById('listen').onclick=()=>{
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!SR)return toast('Speech recognition is not supported in this browser. Try the latest Chrome.');
 if(recognition){recognition.stop();return}
 recognition=new SR();
 recognition.lang=document.getElementById('voiceLanguage').value||'gu-IN';
 recognition.interimResults=true;
 recognition.continuous=true;
 recognition.maxAlternatives=5;
 let finalText='';
 document.getElementById('listen').textContent='■ Stop listening';
 toast('Listening… speak clearly, then tap Stop listening.');
 recognition.onresult=e=>{
  let interim='';
  for(let i=e.resultIndex;i<e.results.length;i++){
   const result=e.results[i];
   const alternatives=Array.from(result).sort((a,b)=>(b.confidence||0)-(a.confidence||0));
   const best=alternatives[0]?.transcript||'';
   if(result.isFinal){finalText+=(finalText?' ':'')+best.trim()}
   else interim+=(interim?' ':'')+best.trim();
  }
  document.getElementById('command').value=(finalText+' '+interim).trim();
 };
 recognition.onerror=e=>{
  const messages={'not-allowed':'Allow microphone permission for this website.','no-speech':'No speech heard. Try again closer to the microphone.',network:'Speech service/network unavailable. Check internet.','audio-capture':'No microphone detected.'};
  toast(messages[e.error]||('Microphone: '+e.error));
 };
 recognition.onend=()=>{
  recognition=null;
  document.getElementById('listen').textContent='🎙 Start listening';
  const box=document.getElementById('command');
  if(finalText.trim())box.value=finalText.trim();
  if(box.value.trim())understand();
 };
 try{recognition.start()}catch(err){recognition=null;document.getElementById('listen').textContent='🎙 Start listening';toast('Could not start microphone. Try again.')}
};

